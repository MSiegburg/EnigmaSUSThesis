module wire_encode {
    input int#(FROM: 0,TO: 26) letter_index
    input int#(FROM: 0,TO: 26) cur_rotor_position
    output int#(FROM: 0,TO: 26) encoded_letter

    int[26] wire_assign = [5,23,1,2,6,11,10,12,24,19,13,0,17,16,25,3,15,22,21,4,8,9,7,14,20,18]
    int letter_index_shift =(letter_index+cur_rotor_position)%26
    encoded_letter=wire_assign[letter_index_shift]

}

