module wire_decode {
    input int#(FROM: 0,TO: 26) letter_index
    input int#(FROM: 0,TO: 26) cur_rotor_position
    output int#(FROM: 0,TO: 26) decoded_letter

    int[26] wire_assign_rev = [11,2,3,15,19,0,4,22,20,21,6,5,7,10,23,15,13,12,25,9,24,18,17,1,8,14]
    int letter_index_shift =(letter_index-cur_rotor_position)%26        //why is this not working ?

    decoded_letter=wire_assign_rev[letter_index_shift]

}

