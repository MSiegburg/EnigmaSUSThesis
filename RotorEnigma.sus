module rotor_position_reg {
    interface start: bool rst
    interface set: bool write_rotor, int#(FROM: 0,TO: 26) set_rotor
    interface rotate: bool advance -> int#(FROM: 0,TO: 26) cur_rotor_position
    
    state int#(FROM: 0,TO: 26) rotor_position 
    initial rotor_position=0

    //initial rotor_position=0
    
    when rst{
        rotor_position=0
    } else when write_rotor{
        rotor_position=set_rotor
    } else when advance{
        rotor_position=(rotor_position+1)%26
    }
    cur_rotor_position = rotor_position
    
}





