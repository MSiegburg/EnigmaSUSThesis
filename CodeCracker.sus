module enigma_machine_driver#(){
    // logic for creating all fixed enigma machines and giving them new incrementing settings for each time the message has been fully parsed

    //seperate rotors and rings setting search do ring settings with prelim "good" rotor settings
    state int#(FROM: 0,TO: 26)[60][5][9] setting_safe
    state int#(FROM: 0,TO: 65536)[60][5] score_safe
    //gen int[3] rotor_setup1
    
    for int I in 0..60{
        ioc_count ioc_count_inst
        ioc_calc ioc_calc_inst
        enigma_machine_runtime enigma_machine_inst
        best_settings best_settings_inst1
        best_settings best_settings_inst2
        best_settings best_settings_inst3
        best_settings best_settings_inst4
        best_settings best_settings_inst5

        best_settings best_settings_inst6
        best_settings best_settings_inst7
        best_settings best_settings_inst8
        best_settings best_settings_inst9
        best_settings best_settings_inst10

        //state int#(FROM: 0,TO: 5)[3] rotor_config 
        gen int[3] rotor_config_compile
        gen int[60][3] config_array
        config_array=[[0, 1, 2],[0, 1, 3],[0, 1, 4],[0, 2, 1],[0, 2, 3],[0, 2, 4],[0, 3, 1],[0, 3, 2],[0, 3, 4],[0, 4, 1],[0, 4, 2],[0, 4, 3],[1, 0, 2],[1, 0, 3],[1, 0, 4],[1, 2, 0],[1, 2, 3],[1, 2, 4],[1, 3, 0],[1, 3, 2],
        [1, 3, 4],[1, 4, 0],[1, 4, 2],[1, 4, 3],[2, 0, 1],[2, 0, 3],[2, 0, 4],[2, 1, 0],[2, 1, 3],[2, 1, 4],[2, 3, 0],[2, 3, 1],[2, 3, 4],[2, 4, 0],[2, 4, 1],[2, 4, 3],[3, 0, 1],[3, 0, 2],[3, 0, 4],[3, 1, 0],[3, 1, 2],[3, 1, 4],
        [3, 2, 0],[3, 2, 1],[3, 2, 4],[3, 4, 0],[3, 4, 1],[3, 4, 2],[4, 0, 1],[4, 0, 2],[4, 0, 3],[4, 1, 0],[4, 1, 2],[4, 1, 3],[4, 2, 0],[4, 2, 1],[4, 2, 3],[4, 3, 0],[4, 3, 1],[4, 3, 2]]
        rotor_config_compile=config_array[I]


        // needed for internal ioc calculations
        state int#(FROM: 0,TO: 65536) multiplication_result
        initial multiplication_result = 0


        // states for saving machine settings and ioc values temporarily
        state int#(FROM: 0,TO: 26)[6] score_settings

        state int#(FROM: 0,TO: 65536) ioc_score_temp1
        state int#(FROM: 0,TO: 26)[6] temp_settings1
        state int#(FROM: 0,TO: 65536) ioc_score_temp2
        state int#(FROM: 0,TO: 26)[6] temp_settings2
        state int#(FROM: 0,TO: 65536) ioc_score_temp3
        state int#(FROM: 0,TO: 26)[6] temp_settings3
        state int#(FROM: 0,TO: 65536) ioc_score_temp4
        state int#(FROM: 0,TO: 26)[6] temp_settings4
        state int#(FROM: 0,TO: 65536) ioc_score_temp5
        state int#(FROM: 0,TO: 26)[6] temp_settings5


        // instantiate an enigma machine with the given rotors
        action machine_setup_rotor: int#(FROM: 0,TO: 26) lrop, int#(FROM: 0,TO: 26) mrop, int#(FROM: 0,TO: 26) rrop -> bool done{
            enigma_machine_inst.setup(rotor_config_compile,[lrop,mrop,rrop],[0,0,0]) 
            enigma_machine_inst.prep_message_encode()
            done=true
        }

        
        // calculate our version of the IoC score 
        action parse_letter_ioc_count: int#(FROM: 0,TO: 26) input_letter-> int#(FROM: 0,TO: 26) decoded_letter{ 
            decoded_letter=enigma_machine_inst.parse_letter(input_letter)
        }
        action ioc_count_input:int#(FROM: 0,TO: 26) input_letter_count{
            ioc_count_inst.letter_input(input_letter_count)
        }
        // safe settings once we get to the last letter of the message
        action last_letter_save_settings_rotor: int#(FROM: 0,TO: 26) lrops, int#(FROM: 0,TO: 26) mrops, int#(FROM: 0,TO: 26) rrops{
            ioc_calc_inst.set_letter_count(ioc_count_inst.pass_letter_count())
            score_settings=[rotor_config_compile[0],rotor_config_compile[1],rotor_config_compile[2],lrops,mrops,rrops,0,0,0]
        }

    
        // sum up our letter counts until we reach the end of the alphabet
        action sum_up_ioc: int#(FROM: 0,TO: 26) cur_letter{
            multiplication_result = multiplication_result + ioc_calc_inst.ioc_calc_individual_letter(cur_letter) mod 65536
        }
        action save_result_ioc_rotors{
                // fill our IoC score modules with the sum result passing down values in order thereby effectively geting a sortet list 
                ioc_score_temp1,temp_settings1=best_settings_inst1.update_check(multiplication_result, score_settings)
                ioc_score_temp2,temp_settings2=best_settings_inst2.update_check(ioc_score_temp1,temp_settings1)     
                ioc_score_temp3,temp_settings3=best_settings_inst3.update_check(ioc_score_temp2,temp_settings2)  
                ioc_score_temp4,temp_settings4=best_settings_inst4.update_check(ioc_score_temp3,temp_settings3)  
                ioc_score_temp5,temp_settings5=best_settings_inst5.update_check(ioc_score_temp4,temp_settings4)  
                // reset relevant values so we can do this again for the next config
                multiplication_result=0
                ioc_count_inst.reset()
        }

        state int#(FROM: 1,TO: 6) cur_best
        initial cur_best=1

        // need to save rotor positions in instances because they will vary across the different machines which rotor positions turn out better
        state int#(FROM: 0,TO: 26) left_rotor_pos
        state int#(FROM: 0,TO: 26) middle_rotor_pos
        state int#(FROM: 0,TO: 26) rigth_rotor_pos

        // go over the 5 best settings for the rotors and get rotor positions from the settings instances
        action pick_from_best_options{
            int#(FROM: 0,TO: 65536) IoC_score_dummy
            int#(FROM: 0,TO: 26)[6] best_settings_cur
            when cur_best==1{
                IoC_score_dummy,best_settings_cur=best_settings_inst1.give_settings()
                rigth_rotor_pos=best_settings_cur[0]
                middle_rotor_pos=best_settings_cur[1]
                left_rotor_pos=best_settings_cur[2]
                cur_best=2
            }else when cur_best==2{
                IoC_score_dummy,best_settings_cur=best_settings_inst2.give_settings()
                rigth_rotor_pos=best_settings_cur[0]
                middle_rotor_pos=best_settings_cur[1]
                left_rotor_pos=best_settings_cur[2]
                cur_best=3
            }else when cur_best==3{
                IoC_score_dummy,best_settings_cur=best_settings_inst3.give_settings()
                rigth_rotor_pos=best_settings_cur[0]
                middle_rotor_pos=best_settings_cur[1]
                left_rotor_pos=best_settings_cur[2]                
                cur_best=4
            }else when cur_best==4{
                IoC_score_dummy,best_settings_cur=best_settings_inst4.give_settings()
                rigth_rotor_pos=best_settings_cur[0]
                middle_rotor_pos=best_settings_cur[1]
                left_rotor_pos=best_settings_cur[2]   
                cur_best=5
            }else when cur_best==5{
                IoC_score_dummy,best_settings_cur=best_settings_inst5.give_settings()
                rigth_rotor_pos=best_settings_cur[0]
                middle_rotor_pos=best_settings_cur[1]
                left_rotor_pos=best_settings_cur[2]
                cur_best=1
            }

        }
        action machine_setup_ring:int#(FROM: 0,TO: 26) left_ring_pos, int#(FROM: 0,TO: 26) middle_ring_pos, int#(FROM: 0,TO: 26) rigth_ring_pos-> bool done_rings{
            enigma_machine_inst.setup(rotor_config_compile,[left_rotor_pos, middle_rotor_pos, rigth_rotor_pos], [left_ring_pos, middle_ring_pos, rigth_ring_pos]) 
            enigma_machine_inst.prep_message_encode()
            done_rings=true
        }

        action last_letter_save_settings_rings: int#(FROM: 0,TO: 26) left_ring_pos_setting,int#(FROM: 0,TO: 26) middle_ring_pos_setting,int#(FROM: 0,TO: 26)rigth_ring_pos_setting{
            ioc_calc_inst.set_letter_count(ioc_count_inst.pass_letter_count())
            score_settings=[rotor_config_compile[0],rotor_config_compile[1],rotor_config_compile[2],left_rotor_pos,middle_rotor_pos,rigth_rotor_pos,left_ring_pos_setting,middle_ring_pos_setting,rigth_ring_pos_setting]
        }

        // seperate action since were saving to different setting instances from the rotor position testing
        action safe_result_ioc_rings{
            ioc_score_temp1,temp_settings1=best_settings_inst6.update_check(multiplication_result, score_settings)
            ioc_score_temp2,temp_settings2=best_settings_inst7.update_check(ioc_score_temp1,temp_settings1)     
            ioc_score_temp3,temp_settings3=best_settings_inst8.update_check(ioc_score_temp2,temp_settings2)  
            ioc_score_temp4,temp_settings4=best_settings_inst9.update_check(ioc_score_temp3,temp_settings3)  
            ioc_score_temp5,temp_settings5=best_settings_inst10.update_check(ioc_score_temp4,temp_settings4) 
            multiplication_result=0
            ioc_count_inst.reset()
        }
                
        state int#(FROM: 0,TO: 26)[9] concat_temp1
        state int#(FROM: 0,TO: 26)[9] concat_temp2
        state int#(FROM: 0,TO: 26)[9] concat_temp3
        state int#(FROM: 0,TO: 26)[9] concat_temp4
        state int#(FROM: 0,TO: 26)[9] concat_temp5    
    
        // get all the best settings out of the setting modules and assign them to our temp values 
        action safe_best_settings_at_end{
            Concat concat_inst

            ioc_score_temp1,temp_settings1=best_settings_inst6.give_settings()
            ioc_score_temp2,temp_settings2=best_settings_inst7.give_settings()
            ioc_score_temp3,temp_settings3=best_settings_inst8.give_settings()
            ioc_score_temp4,temp_settings4=best_settings_inst9.give_settings()
            ioc_score_temp5,temp_settings5=best_settings_inst10.give_settings()

            concat_temp1=concat_inst(temp_settings1, rotor_config_compile)
            concat_temp2=concat_inst(temp_settings2, rotor_config_compile)
            concat_temp3=concat_inst(temp_settings3, rotor_config_compile)
            concat_temp4=concat_inst(temp_settings4, rotor_config_compile)
            concat_temp5=concat_inst(temp_settings5, rotor_config_compile)
            
            setting_safe[:][0][I]=concat_temp1
            setting_safe[:][1][I]=concat_temp2
            setting_safe[:][2][I]=concat_temp3
            setting_safe[:][3][I]=concat_temp4
            setting_safe[:][4][I]=concat_temp5


            score_safe[0][I] = ioc_score_temp1
            score_safe[1][I] = ioc_score_temp2
            score_safe[2][I] = ioc_score_temp3
            score_safe[3][I] = ioc_score_temp4
            score_safe[4][I] = ioc_score_temp5

            //technically dont need to do this
            best_settings_inst1.reset()
            best_settings_inst2.reset()
            best_settings_inst3.reset()
            best_settings_inst4.reset()
            best_settings_inst5.reset()
            best_settings_inst6.reset()
            best_settings_inst7.reset()
            best_settings_inst8.reset()
            best_settings_inst9.reset()
            best_settings_inst10.reset()

        }
    }


    best_configs best_config_to_plug1
    best_configs best_config_to_plug2
    best_configs best_config_to_plug3
    best_configs best_config_to_plug4
    best_configs best_config_to_plug5

    //TODO: meeting

    // sort out the score safe array to get top 5 configs

    action sort_results: int#(FROM: 0,TO: 60) machindex, int#(FROM: 0, TO: 6) scoreindex{
    int#(FROM: 0,TO: 65536) ioc_score_top1
    int#(FROM: 0,TO: 26)[9] best_settings1
    int#(FROM: 0,TO: 65536) ioc_score_top2
    int#(FROM: 0,TO: 26)[9] best_settings2
    int#(FROM: 0,TO: 65536) ioc_score_top3
    int#(FROM: 0,TO: 26)[9] best_settings3
    int#(FROM: 0,TO: 65536) ioc_score_top4
    int#(FROM: 0,TO: 26)[9] best_settings4
    int#(FROM: 0,TO: 65536) ioc_score_top5
    int#(FROM: 0,TO: 26)[9] best_settings5
        ioc_score_top1,best_settings1=best_config_to_plug1.update_check(score_safe[scoreindex][machindex], setting_safe[scoreindex][machindex])
        ioc_score_top2,best_settings2=best_config_to_plug2.update_check(ioc_score_top1, best_settings1)
        ioc_score_top3,best_settings3=best_config_to_plug3.update_check(ioc_score_top2, best_settings2)
        ioc_score_top4,best_settings4=best_config_to_plug4.update_check(ioc_score_top3, best_settings3)
        ioc_score_top5,best_settings5=best_config_to_plug5.update_check(ioc_score_top4, best_settings4)
    }

    action get_top_settings:->int#(FROM: 0,TO: 65536) ioc_score_top1,int#(FROM: 0,TO: 26)[9] best_settings1,int#(FROM: 0,TO: 65536) ioc_score_top2,int#(FROM: 0,TO: 26)[9] best_settings2,int#(FROM: 0,TO: 65536) ioc_score_top3,int#(FROM: 0,TO: 26)[9] best_settings3,int#(FROM: 0,TO: 65536) ioc_score_top4,int#(FROM: 0,TO: 26)[9] best_settings4,int#(FROM: 0,TO: 65536) ioc_score_top5,int#(FROM: 0,TO: 26)[9] best_settings5{
        ioc_score_top1,best_settings1=best_config_to_plug1.give_settings()
        ioc_score_top2,best_settings2=best_config_to_plug2.give_settings()
        ioc_score_top3,best_settings3=best_config_to_plug3.give_settings()
        ioc_score_top4,best_settings4=best_config_to_plug4.give_settings()
        ioc_score_top5,best_settings5=best_config_to_plug5.give_settings()

        best_config_to_plug1.reset()
        best_config_to_plug2.reset()
        best_config_to_plug3.reset()
        best_config_to_plug4.reset()
        best_config_to_plug5.reset()

    }
    
}


module plug_guessing{

    enigma_machine_runtime enigma_machine_plugboard
    bigram_scores bigram_scores_inst
    best_ngram_score best_ngram_score_inst
    // we get 5 settings for the machine these will be the results of our rotor config rotor pos and ring pos guessing earlier 
    // could do compile time for to do it in parallel on all best settings if we have space
    state int#(FROM: 0,TO: 26)[9] given_settings
    // we start with the best one 
    // we start with the first plug 26x25 possible settings
    state bool[26] alphabet
    alphabet=[true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true]     // we could use an array with bools in it to check our combinations against to make sure
    state int#(FROM: 0,TO: 26) plug_one
    state int#(FROM: 0,TO: 26) plug_two
    
    state bool all_pairs_for_step_complete
    state int#(FROM: 0,TO: 16) plugs_in_use
    gen int max_plugs=10

    int#(FROM: 0,TO: 26) decoded_letter_pb

    state int#(FROM: 0,TO: 26) last_decoded_letter

    initial plug_one = 0
    initial plug_two = 1

    state int#(FROM: 0,TO: 4096) increment
    int#(FROM: 0,TO: 4294967296) bigram_score_temp            // 32 bit
    state int#(FROM: 0,TO: 281474976710656) bigram_score_sum        // 48 bit

    state int#(FROM: 0,TO: 281474976710656)dummy_score     //48bit
    state int#(FROM: 0,TO: 26)[2] dummy_plugs

    state bool wait_for_plug_setting
    initial wait_for_plug_setting = true

    action give_settings:int#(FROM: 0,TO: 26)[9] new_settings{
        given_settings=new_settings
    }

    action plug_guessing_machine_setup{
        enigma_machine_plugboard.setup(given_settings[0:3], given_settings[3:6], given_settings[6:9])
    }
 
 // increment over the possible plugs to set up since direction doesnt matter and we cant plug two plugs into the same place 
 // we need to make sure that doesnt happen
    action increment_plug: bool plug_select{
        when plug_select{
            plug_one=plug_one+1 mod 26
        }else{
            plug_two=plug_two+1 mod 26
        }
    }
    action set_two_after_one{
        plug_two=plug_one+1 mod 26
    }
    action check_plug_one_not_done: -> bool done_one{
        when plug_one <26{
            done_one=true
        }
    }    
    action check_plug_two_not_done: -> bool done_two{
        when plug_two <26{
            done_two=true
        }
    }
    action check_two_greater_one: -> bool greater {
        when plug_two>plug_one{
            greater=true
        }
    }
    action reset_plugs{
        plug_one=0
        plug_two=1
    }
    action swap_plugs{
        plug_one=plug_two
        plug_two=plug_one
    }
    action machine_change_plugs{
        enigma_machine_plugboard.change_plugs(plug_one, plug_two)
    }
    action check_alphabet:-> bool plugs_not_used_yet{
        when alphabet[plug_one] & alphabet[plug_two]{
            plugs_not_used_yet=true
        }
    }
    action machine_prep_encode{
        enigma_machine_plugboard.prep_message_encode()
    }
    action increment_counter{
        increment=increment+1 mod 4096
    }
    //TODO: Write comments and check on this tomorrow
    action decode_letter_write_to_last: int#(FROM: 0,TO: 26) input_letter{
        decoded_letter_pb=enigma_machine_plugboard.parse_letter(input_letter)
        last_decoded_letter=decoded_letter_pb
        bigram_score_temp=bigram_scores_inst.get_bigram_score([decoded_letter_pb,last_decoded_letter])
        bigram_score_sum=bigram_score_sum+bigram_score_temp
    }
    action update_plug_score_result{
        dummy_plugs,dummy_score=best_ngram_score_inst.update([plug_one,plug_two], bigram_score_sum)
    }
    action update_plugs_in_use{
        plug_one,plug_two=best_ngram_score_inst.give_plugs()
        alphabet[plug_one]=false
        alphabet[plug_two]=false
        plugs_in_use=plugs_in_use+1 mod 16
    }
}

    //      we set a plug we pipe it through the machine and we see what the result is passing it to the bigram/trigram check 
    //          need to figure out roughly how long this takes or how we are going to store the results 

    //          just a bunch of lookups for bigrams shouldnt take longer then the message decode just checking a 2 dimensional array

    //          for trigrams 3 dimensional array not sure how local that can be but at the end of the day similar timing 
    //          amount of bigrams to check

    //      for each decode run we have to change the plugs but not anything esle so similar overhead to earlier for rotor and ring pos
    //      we use a new variation of the best_settings module to keep our best ranking plug setting 
    //          this should allways be clearly better if we are working with the right rotor settings

