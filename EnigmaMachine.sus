module reflector{
    input int#(FROM: 0,TO: 26) input_letter
    output int#(FROM: 0,TO: 26) output_letter

    // (AY) (BR) (CU) (DH) (EQ) (FS) (GL) (IP) (JX) (KN) (MO) (TZ) (VW) Reflector B 
    gen int[26] reflector_table = [24, 17, 20, 7, 16, 18, 11, 3, 15, 23, 13, 6, 14, 10, 12, 8, 4, 1, 5, 25, 2, 22, 21, 9, 0, 19]
    
    output_letter=reflector_table[input_letter]

}

