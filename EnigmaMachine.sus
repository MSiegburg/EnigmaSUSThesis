module enigma_rotor_I{
    input bool rst
    input bool write_rotor
    input bool advance
    input int#(FROM: 0,TO: 26) set_rotor_I
    input int#(FROM: 0,TO: 26) input_letter

    //input int#(FROM: 0,TO: 26) ring_position_I      // as input when setting up enigma machine or gen variable ? leads to error

    gen int#(FROM: 0,TO: 26) ring_position_I        // leads to different error                                    

    output int#(FROM: 0,TO: 26) output_letter
    output bool advance_next                        // signal to advance the next rotor in line right -> advance middle -> advance left

    state int#(FROM: 0,TO: 26) rotor_position       // register to save rotor position

    gen int turnover_position = 16      // fixed turnover position for Rotor I turnover at Q -> R
    gen int LEN = 25                    // for any for loops over the rotor tables

    
    // [E,K,M,F,L,G,D,Q,V,Z,N,T,O,W,Y,H,X,U,S,P,A,I,B,R,C,J] Rotor I of Enigma
    gen int[26] wire_assign = [4,10,12,5,11,6,3,16,21,25,13,19,14,22,24,7,23,20,18,15,0,8,1,17,2,9]

    
    for int I in 0..LEN{
        wire_assign[I]=wire_assign[I]+ring_position_I  // whats the issue here ?
    }

    when rst{
        rotor_position=0
    } else when write_rotor{
        rotor_position=set_rotor_I
    } else when advance{
        when (rotor_position==turnover_position){
            rotor_position=(rotor_position+1)mod 26
            advance_next=true
        } else {
            rotor_position=(rotor_position+1)mod 26
            advance_next=false
        }
    } 

    
    int letter_index_shift =input_letter+rotor_position mod 26
    output_letter=wire_assign[letter_index_shift]

}

module enigma_rotor_II{

    gen int LEN = 25                    // for any for loops over the rotor tables
    gen int turnover_position = 4       // fixed turnover position for Rotor II turnover at E -> F

}

