module enigma_rotor#(int[26] wire_assign, int turnover_position, int initial_position, int ring_position ){ // setup with inputs for compile time variables 
    state int#(FROM: 0,TO: 26) rotor_position       // register to save rotor position
    gen int LEN = 25
    gen int[26] sub_array_left
    gen int[26] sub_array_right
    gen int modified_turnover_position

    rotor_position=initial_position                 // setup rotor

    modified_turnover_position=(turnover_position+ring_position) mod 26
    
    for int I in 0..LEN{
        sub_array_left[I]=wire_assign[I]+ring_position        
    }
    for int I in 0..LEN{
        sub_array_right[sub_array_left[I]]=I
    }
    // setup for both arrays is done here

    action reset{                                                                                           // reset action to set rotor to 0
        rotor_position=0
    }
    action write_rotor: int#(FROM: 0,TO: 26) write_value -> int#(FROM: 0,TO: 26) new_rotor_position{        // write new value to rotor
        rotor_position=write_value
    }   
    action advance:-> bool advance_signal{                                                                  // advance signal checking for turnover 
        when (rotor_position==modified_turnover_position){
            rotor_position=(rotor_position+1)mod 26
            advance_signal=true
        } else {
            rotor_position=(rotor_position+1)mod 26
            advance_signal=false
        }
    }
    action turnover{
        rotor_position=(rotor_position+1)mod 26
    }
    action encode_left: int#(FROM: 0,TO: 26) letter_index -> int#(FROM: 0,TO: 26) encode_letter{
        encode_letter=sub_array_left[(letter_index+rotor_position)mod 26]
    }
    action encode_right: int#(FROM: 0,TO: 26) rev_letter_index -> int#(FROM: 0,TO: 26) rev_encode_letter{
        rev_encode_letter=sub_array_right[(rev_letter_index+rotor_position)mod 26]
    }

}

// int new_char = reflector(old_char)
module reflector{
    action reflector : int#(FROM: 0,TO: 26) input_letter -> int#(FROM: 0,TO: 26) output_letter {
        // (AY) (BR) (CU) (DH) (EQ) (FS) (GL) (IP) (JX) (KN) (MO) (TZ) (VW) Reflector B 
        gen int[26] reflector_table = [24, 17, 20, 7, 16, 18, 11, 3, 15, 23, 13, 6, 14, 10, 12, 8, 4, 1, 5, 25, 2, 22, 21, 9, 0, 19]
        output_letter=reflector_table[input_letter]
    }
}

module plugboard#(int[26] plugboard_config){
    gen int LEN = 25
    gen int[26] plugboard_settings
    // setting the plugboard to the given array | missing plugs will be set to themselves
    for int I in 0..LEN{
        plugboard_settings[I]=plugboard_config[I]
    }
    action pass_letter: int#(FROM: 0,TO: 26) input_letter -> int#(FROM: 0,TO: 26) output_letter{
            output_letter=plugboard_settings[input_letter]
    }
}

