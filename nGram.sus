module best_ngram_score{
    state int#(FROM: 0,TO: 281474976710656)cur_best     //48bit
    state int#(FROM: 0,TO: 26)[2] plugs_cur
    action update:int#(FROM: 0,TO: 26)[2]plugs_used, int#(FROM: 0,TO: 281474976710656)ngram_score->int#(FROM: 0,TO: 26)[2]plugs_new, int#(FROM: 0,TO: 281474976710656)ngram_score_worse{
        when cur_best<ngram_score{
            ngram_score_worse=cur_best
            cur_best=ngram_score
            plugs_new=plugs_cur
            plugs_cur=plugs_used
        }
    }
    // gives the two plugs used in the ngram score
    action give_plugs:->int#(FROM: 0,TO: 26)plug_one_best,int#(FROM: 0,TO: 26)plug_two_best{
        plug_one_best=plugs_cur[0]
        plug_two_best=plugs_cur[1]
    }
    // gives the score of the current best achieved score for a message
    action give_score:->int#(FROM: 0,TO: 281474976710656)best_score_recorded{
        best_score_recorded=cur_best
    }
    action reset{
        cur_best=0
        plugs_cur=[0,0]
    }
}

